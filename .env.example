# Local-only examples. Replace all values before use outside the Compose fixture stack.
APP_PORT=8000
ENVIRONMENT=development
KEYCLOAK_ISSUER_URL=https://ouros-keycloak.discloud.app/realms/ouros
KEYCLOAK_AUDIENCE=ms-ouros-audience-engine
KEYCLOAK_JWKS_URL=https://ouros-keycloak.discloud.app/realms/ouros/protocol/openid-connect/certs
SOURCE_DATABASE_URL=postgresql://audience_source:audience_source_local_only@localhost:5432/audience
METADATA_DATABASE_URL=postgresql://audience_metadata:audience_metadata_local_only@localhost:5432/audience
REDIS_URL=redis://localhost:6379/0
MONGODB_URI=mongodb://localhost:27017
AUDIENCE_DATABASE_NAME=ouros_audience
SOURCE_TIMEOUT_SECONDS=5
ALLOW_MANUAL_RUN=false
