# Local-only examples. Replace all values before use outside the Compose fixture stack.
APP_PORT=8000
ENVIRONMENT=development
SERVICE_TOKEN=local-only-change-me
SOURCE_DATABASE_URL=postgresql://audience_source:audience_source_local_only@localhost:5432/audience
METADATA_DATABASE_URL=postgresql://audience_metadata:audience_metadata_local_only@localhost:5432/audience
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ouros-audience
S3_PREFIX=
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_USE_SSL=false
CACHE_TTL_SECONDS=3600
SOURCE_TIMEOUT_SECONDS=5
ALLOW_MANUAL_RUN=false
AUDIENCE_CONFIG_PATH=config/audiences.example.yaml
